---
import App from '../App';
import '../styles.css';
import '../responsive.css';
import '../cinematic.css';
import '../finishing.css';
import '../navbar.css';

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://cubycrate.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0F130E" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="description" content="CubyCrate is an open-source, self-hosted file drive for teams. Organize and share files using local or S3-compatible storage on your own server." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CubyCrate" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content="CubyCrate | Simple Self-Hosted File Drive" />
    <meta property="og:description" content="CubyCrate is an open-source, self-hosted file drive for teams. Organize and share files using local or S3-compatible storage on your own server." />
    <meta property="og:image" content="https://cubycrate.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="CubyCrate — Simple Self-Hosted File Drive for Teams" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="CubyCrate | Simple Self-Hosted File Drive" />
    <meta name="twitter:description" content="CubyCrate is an open-source, self-hosted file drive for teams. Organize and share files using local or S3-compatible storage on your own server." />
    <meta name="twitter:image" content="https://cubycrate.com/og-image.png" />
    <meta name="twitter:image:alt" content="CubyCrate — Simple Self-Hosted File Drive for Teams" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://cubycrate.com/#website",
          "url": "https://cubycrate.com/",
          "name": "CubyCrate",
          "description": "CubyCrate is an open-source, self-hosted file drive for teams. Organize and share files using local or S3-compatible storage on your own server."
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://cubycrate.com/#software",
          "name": "CubyCrate",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Linux",
          "softwareVersion": "v0.0.1-alpha.2",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "license": "https://github.com/septian-padli/cubycrate/blob/main/LICENSE",
          "url": "https://cubycrate.com/",
          "downloadUrl": "https://github.com/septian-padli/cubycrate/pkgs/container/cubycrate",
          "codeRepository": "https://github.com/septian-padli/cubycrate",
          "sameAs": [
            "https://github.com/septian-padli/cubycrate"
          ],
          "description": "Lightweight, open-source, self-hosted file drive for teams. Organize and share files using local or S3-compatible storage on your own server.",
          "softwareRequirements": "Docker Engine >= 24.0, Docker Compose >= 2.20",
          "storageRequirements": "Local filesystem storage or S3-compatible object storage",
          "memoryRequirements": "30-50 MB RAM baseline idle footprint"
        }
      ]
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=DM+Mono:wght@400;500&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>CubyCrate | Simple Self-Hosted File Drive</title>
  </head>
  <body>
    <div id="root">
      <App client:load />
    </div>
  </body>
</html>
